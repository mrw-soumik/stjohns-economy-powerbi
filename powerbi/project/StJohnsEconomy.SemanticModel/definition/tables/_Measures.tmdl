	/// Average of the 12 monthly values ending at the latest month; blank until 12 months of data exist.
	measure '12-Month Rolling Average' = ```
			VAR _date = [Latest Date]
			VAR _isMonthly = SELECTEDVALUE ( DimIndicator[Frequency] ) = "Monthly"
			RETURN
			    IF (
			        NOT ISBLANK ( _date ) && _isMonthly && HASONEVALUE ( DimGeography[GeographyKey] ),
			        VAR _start = EDATE ( _date, -11 )
			        VAR _months =
			            CALCULATE (
			                DISTINCTCOUNT ( FactObservation[Date] ),
			                REMOVEFILTERS ( DimDate ),
			                DimDate[Date] >= _start && DimDate[Date] <= _date
			            )
			        RETURN
			            IF (
			                _months = 12,
			                CALCULATE (
			                    AVERAGE ( FactObservation[Value] ),
			                    REMOVEFILTERS ( DimDate ),
			                    DimDate[Date] >= _start && DimDate[Date] <= _date
			                )
			            )
			    )
			```
		displayFolder: 3 Rolling 12 months
		lineageTag: 3dc80063-6865-5daa-8ccb-6d834526c5a6

		formatStringDefinition = SELECTEDVALUE ( DimIndicator[FormatString], "#,0.0" )

	/// Sum of the 12 monthly values ending at the latest month, for flow indicators (dwelling units created by building permits). Removes seasonality without seasonal adjustment.
	measure '12-Month Rolling Total' = ```
			VAR _date = [Latest Date]
			VAR _isFlow = SELECTEDVALUE ( DimIndicator[AggregationMethod] ) = "Sum"
			RETURN
			    IF (
			        NOT ISBLANK ( _date ) && _isFlow && HASONEVALUE ( DimGeography[GeographyKey] ),
			        VAR _start = EDATE ( _date, -11 )
			        VAR _months =
			            CALCULATE (
			                DISTINCTCOUNT ( FactObservation[Date] ),
			                REMOVEFILTERS ( DimDate ),
			                DimDate[Date] >= _start && DimDate[Date] <= _date
			            )
			        RETURN
			            IF (
			                _months = 12,
			                CALCULATE (
			                    SUM ( FactObservation[Value] ),
			                    REMOVEFILTERS ( DimDate ),
			                    DimDate[Date] >= _start && DimDate[Date] <= _date
			                )
			            )
			    )
			```
		formatString: #,0
		displayFolder: 3 Rolling 12 months
		lineageTag: c5d2245d-cb91-5fa4-967c-d10a862bba9a

	measure '12-Month Rolling Total Year Ago' = ```
			VAR _date = [Latest Date]
			RETURN
			    IF (
			        NOT ISBLANK ( _date ),
			        CALCULATE (
			            [12-Month Rolling Total],
			            REMOVEFILTERS ( DimDate ),
			            DimDate[Date] = EDATE ( _date, -12 )
			        )
			    )
			```
		formatString: #,0
		displayFolder: 3 Rolling 12 months
		lineageTag: 3f3a4b6b-a44a-537e-8169-bddebea296cf

	measure '12-Month Rolling Total YoY %' = ```
			VAR _current = [12-Month Rolling Total]
			VAR _yearAgo = [12-Month Rolling Total Year Ago]
			RETURN
			    IF (
			        NOT ISBLANK ( _current ) && NOT ISBLANK ( _yearAgo ),
			        DIVIDE ( _current - _yearAgo, _yearAgo )
			    )
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 Rolling 12 months
		lineageTag: a1688196-4deb-58ef-b103-93ba7ee4fb1d

	/// Month picked in the BasePeriod slicer (January 2018 if none). Annual series use their reference day in the base year (July 1 for population).
	measure 'Base Date' = ```
			VAR _selected = SELECTEDVALUE ( BasePeriod[BaseDate], DATE ( 2018, 1, 1 ) )
			VAR _referenceDay = SELECTEDVALUE ( DimIndicator[ReferenceDay] )
			RETURN
			    IF (
			        SELECTEDVALUE ( DimIndicator[Frequency] ) = "Annual" && NOT ISBLANK ( _referenceDay ),
			        DATE (
			            YEAR ( _selected ),
			            VALUE ( LEFT ( _referenceDay, 2 ) ),
			            VALUE ( RIGHT ( _referenceDay, 2 ) )
			        ),
			        _selected
			    )
			```
		formatString: mmm yyyy
		displayFolder: 4 Index to base period
		lineageTag: ab2cddf2-8aa6-5026-bb85-ad21c159f9de

	measure 'Base Value' = ```
			VAR _base = [Base Date]
			RETURN
			    CALCULATE ( [Value], REMOVEFILTERS ( DimDate ), DimDate[Date] = _base )
			```
		displayFolder: 4 Index to base period
		lineageTag: b2c3ecee-59e0-58eb-bb97-aa8cfe5e67c9

