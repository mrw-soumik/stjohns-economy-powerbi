	/// Statistics Canada Open Licence notice for adapted products, with the tables behind the current visual and its latest reference period.
	measure 'Source Note' = ```
			VAR _tables = CALCULATETABLE ( VALUES ( DimSeries[TableId] ), FactObservation )
			VAR _list = CONCATENATEX ( _tables, DimSeries[TableId], ", ", DimSeries[TableId], ASC )
			VAR _label = IF ( COUNTROWS ( _tables ) > 1, "tables ", "table " )
			RETURN
			    IF (
			        COUNTROWS ( _tables ) > 0,
			        "Adapted from Statistics Canada, " & _label & _list & ", data to "
			            & FORMAT ( [Latest Date], "mmmm yyyy" )
			            & ". This does not constitute an endorsement by Statistics Canada of this product."
			    )
			```
		displayFolder: 8 Display
		lineageTag: 65877915-650d-5b13-9b68-32808152cccd

	measure 'Caution Note' = ```
			VAR _flagged = CALCULATE ( COUNTROWS ( FactObservation ), FactObservation[Status] = "E" )
			RETURN
			    IF ( _flagged > 0, "Includes values flagged E (use with caution) by Statistics Canada." )
			```
		displayFolder: 8 Display
		lineageTag: 4f90fd43-c114-507d-a2c4-ffb193717d4b

