	/// Rebases any series to 100 in the base period so that St. John's, the province and Canada share one axis (no dual axes).
	measure 'Index (Base = 100)' = ```
			VAR _base = [Base Value]
			VAR _current = [Latest Value]
			RETURN
			    IF (
			        NOT ISBLANK ( _base ) && NOT ISBLANK ( _current ),
			        DIVIDE ( _current, _base ) * 100
			    )
			```
		formatString: 0.0
		displayFolder: 4 Index to base period
		lineageTag: 97b8efeb-9fa1-5799-b8b8-b323778d26c0

	measure 'Change Since Base %' = ```
			VAR _index = [Index (Base = 100)]
			RETURN
			    IF ( NOT ISBLANK ( _index ), _index / 100 - 1 )
			```
