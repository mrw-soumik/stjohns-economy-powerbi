	measure 'Gap Assessment' = ```
			VAR _raw = [Gap vs Canada (Display)]
			VAR _gap = ROUND ( _raw, 1 )
			VAR _direction = SELECTEDVALUE ( DimIndicator[Direction] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _raw ), BLANK (),
			        _gap = 0 || _direction = "Neutral", "Neutral",
			        ( _gap > 0 && _direction = "Higher is better" )
			            || ( _gap < 0 && _direction = "Lower is better" ), "Favourable",
			        "Unfavourable"
			    )
			```
		displayFolder: 8 Display
		lineageTag: b1283b35-5f7d-57e0-9190-e97c1dc362db

	/// For example "1.3 pts above Canada (12-month change)".
	measure 'Gap vs Canada Label' = ```
			VAR _raw = [Gap vs Canada (Display)]
			VAR _gap = ROUND ( _raw, 1 )
			VAR _suffix =
			    IF ( SELECTEDVALUE ( DimIndicator[ChangeType] ) = "Points", "", " (12-month change)" )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _raw ), BLANK (),
			        SELECTEDVALUE ( DimGeography[GeographyCode] ) = "CA", BLANK (),
			        _gap > 0, FORMAT ( _gap, "0.0" ) & " pts above Canada" & _suffix,
			        _gap < 0, FORMAT ( -_gap, "0.0" ) & " pts below Canada" & _suffix,
			        "Same as Canada" & _suffix
			    )
			```
		displayFolder: 8 Display
		lineageTag: c8173443-039c-592c-92e2-0829ca8c7768

	measure 'Gap Colour' = ```
