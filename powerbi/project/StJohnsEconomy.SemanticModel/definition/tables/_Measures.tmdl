	/// 1 when the 12-month change exceeds 1.96 standard errors (95% level), 0 when it does not, blank when no standard error is published.
	measure 'YoY Change Is Significant' = ```
			VAR _change = [YoY Change]
			VAR _se = [YoY Standard Error]
			RETURN
			    IF (
			        NOT ISBLANK ( _change ) && NOT ISBLANK ( _se ),
			        IF ( ABS ( _change ) > 1.96 * _se, 1, 0 )
			    )
			```
		formatString: 0
		displayFolder: 6 Survey precision
		lineageTag: d417d57e-1060-58f9-9342-f69e7480844b

	/// Tests ISBLANK first because BLANK() = 0 is TRUE in DAX.
	measure 'YoY Significance Label' = ```
			VAR _significant = [YoY Change Is Significant]
			RETURN
			    IF (
			        NOT ISBLANK ( _significant ),
			        IF (
			            _significant = 1,
			            "Statistically significant (95% level)",
			            "Within sampling error (95% level)"
			        )
			    )
			```
		displayFolder: 6 Survey precision
		lineageTag: 3a97a9d9-42fb-57b7-9652-41d1654c50ae

	/// Share of dwelling units created in multiple-dwelling buildings. Works on any period (month, year, rolling window via the date filter).
	measure 'Multi-unit Share %' = ```
			VAR _multi =
			    CALCULATE (
			        [Value],
			        REMOVEFILTERS ( DimIndicator ),
			        DimIndicator[IndicatorCode] = "BP_UNITS_MULTI"
			    )
			VAR _total =
			    CALCULATE (
			        [Value],
			        REMOVEFILTERS ( DimIndicator ),
			        DimIndicator[IndicatorCode] = "BP_UNITS"
			    )
			RETURN
			    DIVIDE ( _multi, _total )
			```
		formatString: 0.0%
		displayFolder: 7 Housing
		lineageTag: fdf9e3b7-8d66-5481-bb9c-8f0fff16d423

	/// Dwelling units created by permits in the 12 months to the latest permit month, per 1,000 residents, using the latest July 1 population estimate on or before that month. Puts St. John's, the province and Canada on one scale. Works without an indicator filter: the month is taken from the building permit series, not from whichever indicator was released last.
	measure 'Units Permitted per 1,000 Residents' = ```
			VAR _date =
			    CALCULATE (
			        MAX ( FactObservation[Date] ),
			        REMOVEFILTERS ( DimIndicator ),
			        DimIndicator[IndicatorCode] = "BP_UNITS"
			    )
			VAR _units =
			    CALCULATE (
			        [12-Month Rolling Total],
			        REMOVEFILTERS ( DimIndicator ),
			        DimIndicator[IndicatorCode] = "BP_UNITS",
			        REMOVEFILTERS ( DimDate ),
			        DimDate[Date] = _date
			    )
			VAR _populationDate =
			    CALCULATE (
			        MAX ( FactObservation[Date] ),
			        REMOVEFILTERS ( DimIndicator ),
			        DimIndicator[IndicatorCode] = "POP",
			        REMOVEFILTERS ( DimDate ),
			        DimDate[Date] <= _date
			    )
			VAR _population =
			    CALCULATE (
			        [Value],
			        REMOVEFILTERS ( DimIndicator ),
			        DimIndicator[IndicatorCode] = "POP",
			        REMOVEFILTERS ( DimDate ),
			        DimDate[Date] = _populationDate
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _date ) && NOT ISBLANK ( _units ) && NOT ISBLANK ( _population ),
			        DIVIDE ( _units, _population ) * 1000
			    )
			```
		formatString: 0.0
		displayFolder: 7 Housing
		lineageTag: 0d5cfba1-bacf-5112-8441-ffccf8966a51

	/// For example "0.7 below Canada (7.2)".
	measure 'Units per 1,000 vs Canada Label' = ```
			VAR _local = [Units Permitted per 1,000 Residents]
			VAR _canada =
			    CALCULATE (
			        [Units Permitted per 1,000 Residents],
			        REMOVEFILTERS ( DimGeography ),
			        DimGeography[GeographyCode] = "CA"
			    )
			VAR _gap = ROUND ( _local - _canada, 1 )
			VAR _reference = " Canada (" & FORMAT ( _canada, "0.0" ) & ")"
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _local ) || ISBLANK ( _canada ), BLANK (),
			        SELECTEDVALUE ( DimGeography[GeographyCode] ) = "CA", BLANK (),
			        _gap > 0, FORMAT ( _gap, "0.0" ) & " above" & _reference,
			        _gap < 0, FORMAT ( -_gap, "0.0" ) & " below" & _reference,
			        "Same as" & _reference
			    )
			```
		displayFolder: 7 Housing
		lineageTag: f5457cdb-121f-5da0-aa00-ff7e94ff1cb2

	/// More permitted units per resident than Canada is treated as favourable.
	measure 'Units per 1,000 vs Canada Colour' = ```
			VAR _local = [Units Permitted per 1,000 Residents]
			VAR _canada =
			    CALCULATE (
			        [Units Permitted per 1,000 Residents],
			        REMOVEFILTERS ( DimGeography ),
			        DimGeography[GeographyCode] = "CA"
			    )
			VAR _gap = ROUND ( _local - _canada, 1 )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _local ) || ISBLANK ( _canada ), BLANK (),
			        _gap > 0, "#006300",
			        _gap < 0, "#d03b3b",
			        "#52514e"
			    )
			```
		displayFolder: 7 Housing
		lineageTag: fe7492fb-6380-5fa5-9af9-26599c39469a

	/// "12-month change, August 2026": subtitle for cards that show [YoY %].
	measure 'YoY Period Label' = ```
			VAR _period = [Latest Period Label]
			RETURN
			    IF ( NOT ISBLANK ( _period ), "12-month change, " & _period )
			```
		displayFolder: 8 Display
