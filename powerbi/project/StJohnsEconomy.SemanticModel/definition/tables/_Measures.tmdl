	/// Rates (unemployment, employment, participation) change in percentage points; everything else changes in per cent.
	measure 'YoY Headline Change' = ```
			IF (
			    SELECTEDVALUE ( DimIndicator[ChangeType] ) = "Points",
			    [YoY Change],
			    [YoY %]
			)
			```
