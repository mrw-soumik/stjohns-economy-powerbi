	/// Favourable / Unfavourable / Neutral, from the indicator's Direction. Labour Force Survey changes that are within sampling error are reported as "Not significant".
	measure 'YoY Assessment' = ```
			VAR _change = [YoY Headline Change]
			VAR _rounded =
			    IF (
			        SELECTEDVALUE ( DimIndicator[ChangeType] ) = "Points",
			        ROUND ( _change, 1 ),
			        ROUND ( _change, 3 )
			    )
			VAR _direction = SELECTEDVALUE ( DimIndicator[Direction] )
			VAR _significant = [YoY Change Is Significant]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _change ), BLANK (),
			        NOT ISBLANK ( _significant ) && _significant = 0, "Not significant",
			        _rounded = 0 || _direction = "Neutral", "Neutral",
			        ( _rounded > 0 && _direction = "Higher is better" )
			            || ( _rounded < 0 && _direction = "Lower is better" ), "Favourable",
			        "Unfavourable"
			    )
			```
		displayFolder: 8 Display
		lineageTag: 65c934b0-4e78-5311-ad8e-ac16e71a461b

	/// For example "▼ -0.4 pts from Sep 2025 (not significant)".
	measure 'YoY Delta Label' = ```
			VAR _change = [YoY Headline Change]
			VAR _isPoints = SELECTEDVALUE ( DimIndicator[ChangeType] ) = "Points"
			VAR _amount =
			    IF (
			        _isPoints,
			        FORMAT ( _change, "+0.0;-0.0;0.0" ) & " pts",
			        FORMAT ( _change, "+0.0%;-0.0%;0.0%" )
			    )
			VAR _when =
			    FORMAT (
			        [Year Ago Date],
			        IF ( SELECTEDVALUE ( DimIndicator[Frequency] ) = "Annual", "yyyy", "mmm yyyy" )
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _change ),
			        [Change Direction Icon] & " " & _amount & " from " & _when
			            & " (" & LOWER ( [YoY Assessment] ) & ")"
			    )
			```
		displayFolder: 8 Display
		lineageTag: 584136a4-c707-54aa-876f-c74d3ea6250d

	measure 'YoY Delta Colour' = ```
			SWITCH ( [YoY Assessment], "Favourable", "#006300", "Unfavourable", "#d03b3b", "#52514e" )
			```
		displayFolder: 8 Display
		lineageTag: ee8fd69a-b5b8-513c-9a64-eb99fe93bcff

	/// Rates: level gap in points. Other indicators: gap between 12-month changes.
	measure 'Gap vs Canada (Display)' = ```
			IF (
			    SELECTEDVALUE ( DimIndicator[ChangeType] ) = "Points",
			    [Gap vs Canada],
			    [YoY Gap vs Canada (pts)]
			)
