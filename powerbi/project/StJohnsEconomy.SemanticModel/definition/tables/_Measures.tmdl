table _Measures
	lineageTag: 96992dda-3f67-5824-b971-6cb3a7229f10

	/// Averages stocks, rates and indexes; sums flows (building permits).
	measure Value = ```
			VAR _method = SELECTEDVALUE ( DimIndicator[AggregationMethod] )
			RETURN
			    IF (
			        HASONEVALUE ( DimGeography[GeographyKey] ),
			        SWITCH (
			            _method,
			            "Sum", SUM ( FactObservation[Value] ),
			            "Average", AVERAGE ( FactObservation[Value] )
			        )
			    )
			```
		displayFolder: 1 Core
		lineageTag: c543243e-99ef-555f-832a-c2e086d5ea36

		formatStringDefinition = SELECTEDVALUE ( DimIndicator[FormatString], "#,0.0" )

	measure 'Latest Date' = ```
			MAX ( FactObservation[Date] )
			```
		formatString: mmm yyyy
		displayFolder: 1 Core
		lineageTag: f5943402-3921-5e6c-9442-3c9957dbb904

	measure 'Latest Value' = ```
			VAR _date = [Latest Date]
			RETURN
			    IF (
			        NOT ISBLANK ( _date ),
			        CALCULATE ( [Value], REMOVEFILTERS ( DimDate ), DimDate[Date] = _date )
			    )
			```
		displayFolder: 1 Core
		lineageTag: c3e37248-8797-5ec1-8e04-5381cc73fa3f

		formatStringDefinition = SELECTEDVALUE ( DimIndicator[FormatString], "#,0.0" )

	/// "August 2026" for monthly series, "July 1, 2025" for annual population.
	measure 'Latest Period Label' = ```
			VAR _date = [Latest Date]
			RETURN
			    IF (
			        NOT ISBLANK ( _date ),
			        IF (
			            SELECTEDVALUE ( DimIndicator[Frequency] ) = "Annual",
			            FORMAT ( _date, "mmmm d, yyyy" ),
			            FORMAT ( _date, "mmmm yyyy" )
			        )
			    )
			```
		displayFolder: 1 Core
		lineageTag: 8799fabf-1532-5c05-a282-35dcf39a475f

	measure 'Previous Period Date' = ```
			VAR _date = [Latest Date]
			VAR _months =
			    SWITCH (
			        SELECTEDVALUE ( DimIndicator[Frequency] ),
			        "Monthly", 1,
			        "Quarterly", 3,
			        "Annual", 12
			    )
			RETURN
			    IF ( NOT ISBLANK ( _date ) && NOT ISBLANK ( _months ), EDATE ( _date, -_months ) )
			```
